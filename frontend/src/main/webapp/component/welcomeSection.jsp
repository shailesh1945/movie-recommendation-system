<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8"%>

<section class="container-fluid py-5">

	<div class="row align-items-center g-4">

		<!-- Left Content -->
		<div class="col-lg-7">

			<h1 class="display-2 fw-bold text-white">Welcome Back, Julian</h1>

			<p class="fs-5 text-secondary mt-3 w-75">The theater is ready.
				We've curated a list of premieres you might have missed since your
				last visit.</p>

		</div>

		<!-- Right Card -->
		<div class="col-lg-5">

			<div class="card border-0 text-white rounded-4"
				style="background: linear-gradient(135deg, #24262d, #3b2027);">

				<div class="card-body p-4">

					<span
						class="badge rounded-pill bg-warning text-dark px-3 py-2 mb-4">
						PREMIUM MEMBER </span>

					<h3 class="fw-bold mb-2">Elite Plan</h3>

					<p class="text-secondary mb-4">Next billing cycle: Oct 24, 2023
					</p>

					<button class="btn btn-secondary w-100 fw-semibold py-3">
						Manage Subscription</button>

				</div>

			</div>

		</div>

	</div>

</section>